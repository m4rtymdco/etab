{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{app,config,views,database,public}/**"
    },
    "api/install.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{app,config,views,database}/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/install.php", "dest": "/api/install.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
