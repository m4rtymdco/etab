{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.4",
      "config": {
        "includeFiles": ["app/**", "config/**", "views/**", "database/**", "public/**", "index.php"]
      }
    },
    {
      "src": "api/install.php",
      "use": "vercel-php@0.7.4",
      "config": {
        "includeFiles": ["config/**", "database/**", "install.php"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/install.php", "dest": "/api/install.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
