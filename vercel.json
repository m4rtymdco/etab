{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{app,config,views,database,public}/**"
    },
    "api/install.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{app,config,views,database}/**"
    }
  },
  "rewrites": [
    { "source": "/install.php", "destination": "/api/install.php" },
    { "source": "/((?!public/).*)", "destination": "/api/index.php" }
  ]
}
